{
  "name": "vernesoft/sdk",
  "version": "1.5.0",
  "description": "Official PHP SDK for Nautilus by Verne Software: sign-in and users, webhook delivery, cron jobs and Telegram sign-in. Hosted in France.",
  "keywords": [
    "nautilus",
    "verne",
    "sdk",
    "authentication",
    "webhooks",
    "cron",
    "telegram-login",
    "jwt",
    "ory-kratos",
    "svix",
    "gdpr",
    "eu-hosted"
  ],
  "homepage": "https://vernesoft.com",
  "type": "library",
  "license": "MIT",
  "support": {
    "docs": "https://docs.vernesoft.com",
    "source": "https://github.com/Verne-Software/vrn-sdk-php",
    "issues": "https://github.com/Verne-Software/vrn-sdk-php/issues"
  },
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.0"
  },
  "suggest": {
    "ext-openssl": "Needed by GateTokenVerifier / tokens()->verifySigned() to verify Gate signed tokens (ES256)."
  },
  "autoload": {
    "psr-4": {
      "Vernesoft\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vernesoft\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit --testsuite Integration",
    "lint": "pint --test"
  }
}
