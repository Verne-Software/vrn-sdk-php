{
  "name": "vernesoft/sdk",
  "version": "1.4.0",
  "description": "Official PHP SDK for the Verne Nautilus platform",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.0"
  },
  "suggest": {
    "ext-openssl": "Needed by GateTokenVerifier / tokens()->verifySigned() to verify Gate signed tokens (ES256)."
  },
  "autoload": {
    "psr-4": {
      "Vernesoft\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vernesoft\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit --testsuite Integration",
    "lint": "pint --test"
  }
}
